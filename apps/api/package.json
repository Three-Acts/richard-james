{
  "name": "@three-acts/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false scripts/dev-server.ts",
    "dev:vercel": "vercel dev --yes --listen 0.0.0.0:5175",
    "build": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "schema:sql": "tsx scripts/print-schema.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "auth:create-editor": "tsx scripts/create-editor.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^5.5.13",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vercel": "^48.10.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@three-acts/cms-schema": "*",
    "@vercel/functions": "^3.9.9",
    "pg": "^8.23.0"
  }
}

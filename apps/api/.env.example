# --- Vercel ---
# Set exactly these keys on the Vercel `api` project (Project > Settings >
# Environment Variables): DATABASE_URL, NEON_AUTH_BASE_URL, NEON_AUTH_ORIGIN,
# AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# VERCEL_DEPLOY_HOOK_URL, VERCEL_TOKEN, VERCEL_PROJECT_ID. Optional:
# VERCEL_TEAM_ID, VERCEL_API_BASE, PUBLISH_TOKEN, API_ALLOWED_ORIGINS,
# NEON_AUTH_SESSION_COOKIE (only if Neon ever changes the cookie name).
# Not needed on Vercel: DATABASE_URL_UNPOOLED is read only by the local
# `db:migrate` script (the deployed functions never touch it), and
# NEON_AUTH_JWKS_URL / NEON_BRANCH are written by `neon env pull` into
# apps/api/.env.local but aren't read by anything today.

# Browser origins allowed to call the API directly (cross-origin). Normal
# traffic is same-origin via the /api/* rewrite, so this is only needed for
# direct browser calls. Defaults (used when this is unset) already include
# the Vite dev ports (5173/5174) and the Astro dev/preview ports (4321 dev,
# 4173 preview) on localhost and 127.0.0.1.
API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Publishing (CMS "Publish" -> Vercel deploy) + /api/cms/* auth ---
# Shared secret accepted as `Authorization: Bearer <PUBLISH_TOKEN>` on every
# /api/cms/* route plus /api/deploy and /api/deploy-status, checked in
# constant time. Optional: mainly for scripts/CI that need to call these
# routes without an editor session. Editors authenticate via NEON_AUTH_BASE_URL
# below instead (see requireAuth in api/_lib/auth.ts). Auth is required in
# every environment: when BOTH are unset, these endpoints respond 503 always
# (no dev-mode bypass).
PUBLISH_TOKEN=
# Deploy Hook URL for the web project (Vercel > Project > Settings > Git > Deploy Hooks).
VERCEL_DEPLOY_HOOK_URL=
# Token + project used to poll live deployment status (Vercel > Account > Tokens).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Optional, for team-scoped projects.
VERCEL_TEAM_ID=
# Optional override for the Vercel REST API base URL (self-hosted proxies or
# local testing). Defaults to https://api.vercel.com.
VERCEL_API_BASE=

# --- Neon Postgres (server-side; content + CMS data) ---
# Pooled connection (PgBouncer, transaction mode): normal request traffic,
# used by api/_lib/db.ts's pg Pool.
DATABASE_URL=
# Direct/unpooled connection: schema migrations only (npm run db:migrate).
DATABASE_URL_UNPOOLED=

# --- Neon Auth (managed Better Auth; editor login for the CMS) ---
# Branch Auth URL, e.g. https://<branch>.neonauth.<region>.aws.neon.tech. Reached
# over plain REST from api/_lib/neon-auth.ts (sign-in/email, get-session,
# sign-out, sign-up/email) — the CMS never calls it directly.
NEON_AUTH_BASE_URL=
# Injected JWKS URL for verifying Neon Auth JWTs directly (documented for a
# future option; not used by requireAuth today, which verifies via
# get-session instead since the CMS never holds a JWT — they expire in 15m).
NEON_AUTH_JWKS_URL=
# Name of the session cookie Neon Auth sets on sign-in. Confirmed empirically
# against the live service (note the hyphen in "neon-auth"); override only if
# Neon changes it.
NEON_AUTH_SESSION_COOKIE=__Secure-neon-auth.session_token
# Origin header sent on sign-in/email, sign-up/email and sign-out (Neon Auth
# rejects those with 403 MISSING_ORIGIN/MISSING_OR_NULL_ORIGIN otherwise —
# confirmed empirically; get-session doesn't need it). Any localhost:<port>
# origin is pre-approved with no extra config, so the default below works for
# local dev and scripts. In production, set this to a real origin registered
# with `neon neon-auth domain add <origin>` (e.g. the CMS's deployed URL).
NEON_AUTH_ORIGIN=http://localhost:5175

# --- Neon object storage (server-side; CMS asset uploads + seeded images) ---
# S3-compatible; bucket "public" is provisioned public_read (see neon.ts).
# Standard AWS_* names so the AWS SDK picks them up with zero extra config.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local development ---
# Neon is the only backend (no local/in-memory fallback): the data store and
# blob store are always NeonDataStore/NeonBlobStore (api/_lib/cms/resolve-store.ts).
# Each throws a clear "unavailable" error naming the specific missing variable
# the first time a request actually needs it (DATABASE_URL for data;
# AWS_ENDPOINT_URL_S3/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for storage) —
# there's nothing else to configure here to select a backend.
#
# `npm run dev -w @three-acts/api` (scripts/dev-server.ts) loads this file
# first, then `apps/api/.env.local` — the file `neon env pull --file
# apps/api/.env.local` writes with the linked branch's live
# DATABASE_URL/DATABASE_URL_UNPOOLED/NEON_AUTH_BASE_URL/NEON_AUTH_JWKS_URL/
# AWS_* vars (run from the repo root; see README's "Neon setup") — so once
# that file exists, `npm run dev:api` works with no manual copying beyond
# this file's own app-local settings (API_ALLOWED_ORIGINS, NEON_AUTH_ORIGIN,
# and PUBLISH_TOKEN if you want one for local scripts). `npm run
# db:migrate`/`db:seed`/`auth:create-editor` load the same two files in the
# opposite order (`apps/api/.env.local` first, this file second) since those
# scripts always target the live linked branch.
#
# To get the same values for Vercel's project env vars, run
# `neon-env export --format dotenv` (from `@neon/env` at the repo root) and
# copy the relevant keys into the Vercel dashboard (or `vercel env add`) —
# see the "Vercel" note above for exactly which keys are needed there.
#
# To add another backend (a different Postgres host, Cloudflare R2, ...),
# implement CmsDataStore / CmsBlobStore in api/_lib/cms and register it in
# api/_lib/cms/resolve-store.ts. `npm run schema:sql -w @three-acts/api`
# prints the generated CREATE TABLE SQL for any Postgres-compatible target.

# apps/api/.env.local — the only env file the API reads locally. Keys are listed
# in the order `neon env pull --file apps/api/.env.local` writes them, followed
# by the app-local keys you add to that same file by hand (env pull preserves
# them). Gitignored via `*.local`; never commit it.

# ---- Written by `neon env pull` (do not edit by hand) ----
# Pooled connection (PgBouncer): request traffic via api/_lib/db.ts.
DATABASE_URL=
# Direct connection: `npm run db:migrate` only (DDL doesn't work pooled). Local only.
DATABASE_URL_UNPOOLED=
# Informational; not read by anything.
NEON_BRANCH=
# Neon Auth REST base used by api/_lib/neon-auth.ts.
NEON_AUTH_BASE_URL=
# Not read today (requireAuth verifies via get-session, not JWTs).
NEON_AUTH_JWKS_URL=
# Neon object storage (S3-compatible, bucket "public"); standard AWS_* names
# so the AWS SDK picks them up with no extra config.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# ---- App-local (add by hand) ----
# Origin header for Neon Auth sign-in/sign-up/sign-out (403 without it). Any
# localhost:<port> works locally; production must be a registered origin
# (`neon neon-auth domain add <origin>`).
NEON_AUTH_ORIGIN=http://localhost:5175
# Browser origins allowed to call the API cross-origin. Unset = localhost and
# 127.0.0.1 on the Vite (5173/5174) and Astro (4321/4173) dev ports.
API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Optional ----
# Bearer token accepted on /api/cms/*, /api/deploy, /api/deploy-status for
# scripts/CI. Editors use Neon Auth sessions instead. With neither this nor
# NEON_AUTH_BASE_URL set, those routes always return 503.
PUBLISH_TOKEN=
# CMS Publish -> Vercel deploy of the web project, and deployment-status polling.
VERCEL_DEPLOY_HOOK_URL=
VERCEL_TOKEN=
# NOT VERCEL_PROJECT_ID: Vercel auto-injects that as a system env var set to
# *this* (api) project's own id, silently overriding a manually-set value
# meant to point at the site project. The site project id is instead parsed
# from VERCEL_DEPLOY_HOOK_URL's path; set SITE_VERCEL_PROJECT_ID here only if
# that URL is ever unset or unparseable (e.g. local testing).
SITE_VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Defaults to https://api.vercel.com.
VERCEL_API_BASE=
# Session cookie name Neon Auth sets; override only if Neon renames it.
NEON_AUTH_SESSION_COOKIE=__Secure-neon-auth.session_token

# ---- Vercel `api` project ----
# Set there: DATABASE_URL, NEON_AUTH_BASE_URL, NEON_AUTH_ORIGIN, AWS_ENDPOINT_URL_S3,
# AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, VERCEL_DEPLOY_HOOK_URL,
# VERCEL_TOKEN. Optional: SITE_VERCEL_PROJECT_ID (only if VERCEL_DEPLOY_HOOK_URL
# can't be parsed), VERCEL_TEAM_ID, VERCEL_API_BASE, PUBLISH_TOKEN,
# API_ALLOWED_ORIGINS, NEON_AUTH_SESSION_COOKIE. Do NOT set VERCEL_PROJECT_ID —
# it's a Vercel system var that Vercel itself overwrites at runtime.
# Values: `neon-env export --format dotenv` from the repo root.

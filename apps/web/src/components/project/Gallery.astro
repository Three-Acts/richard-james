---
import type { ProjectContent } from '@/content/types'
import Image from '@/components/ui/Image.astro'
import Reveal from '@/components/ui/Reveal.astro'

export interface Props {
  project: ProjectContent
}

/**
 * A masonry gallery: two columns on desktop and one on mobile. Each successive
 * image fills the shorter column, avoiding the empty space a shared grid row
 * leaves beneath landscape images beside portraits. DOM and viewer order stay
 * in the CMS's sequence; a regular grid remains available without JavaScript.
 *
 * Each image keeps its natural aspect ratio, caption and scroll reveal.
 *
 * A project may set `gridStride` to show only every Nth image here (works
 * documented as near-identical runs of frames). The fullscreen viewer always
 * receives the COMPLETE list, so the frames omitted from the grid are still
 * reachable by swiping — which is why each button carries its index into the
 * full list, not into the visible subset.
 *
 * Clicking an image opens that viewer, the one genuinely interactive piece here.
 * It shares the gesture engine with the home stage, so it stays React and is
 * pulled in by a dynamic import on the first click (see mountLightbox.tsx) —
 * a visitor who only reads the page never downloads the framework.
 */
const { project } = Astro.props

const images = project.images
const total = images.length

const stride = Math.max(1, project.gridStride ?? 1)
// Keep each image's position in the full list — that index is what the viewer opens on.
const visible = images
  .map((image, index) => ({ image, index }))
  .filter(({ index }) => index % stride === 0)
---

<section
  data-gallery
  aria-label={`${project.title} — gallery`}
  class="u-container pb-[clamp(5rem,14vh,11rem)]"
>
  <div class="masonry-gallery" data-masonry>
    {
      visible.map(({ image, index }, position) => (
        <figure class="gallery-item" data-masonry-item>
          {/* Keep the quiet alternating reveal without tying it to fixed-height rows. */}
          <Reveal y={32} delay={(position % 2) * 0.08}>
            <button
              type="button"
              data-lightbox-open={index}
              aria-label={
                total > 1
                  ? `View ${project.title} — image ${index + 1} of ${total} full screen`
                  : `View ${project.title} full screen`
              }
              class="group block w-full cursor-zoom-in overflow-hidden focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-gold"
            >
              <Image
                src={image.src}
                alt={
                  total > 1
                    ? `${project.title} — view ${index + 1} of ${total}`
                    : project.title
                }
                sizes="(min-width: 768px) 50vw, 100vw"
                class="w-full transition-transform duration-900 ease-out-expo group-hover:scale-[1.02]"
              />
            </button>

            {image.caption && (
              <figcaption class="mt-3 max-w-2xl font-body text-sm leading-relaxed text-bone-dim">
                {image.caption}
              </figcaption>
            )}
          </Reveal>
        </figure>
      ))
    }
  </div>

  {/* The viewer's data, handed to the on-demand React chunk. Kept out of the
      click handler's bundle so the payload scales with the project, not the JS. */}
  <script
    is:inline
    type="application/json"
    data-gallery-payload
    set:html={JSON.stringify({ images, title: project.title })}
  />
</section>

<style>
  .masonry-gallery {
    --gallery-columns: 1;
    --gallery-gap: 24px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    align-items: start;
    gap: var(--gallery-gap);
  }

  .masonry-gallery[data-masonry-ready] {
    display: block;
  }

  .masonry-gallery[data-masonry-ready] > .gallery-item {
    position: absolute;
    width: calc((100% - (var(--gallery-columns) - 1) * var(--gallery-gap)) / var(--gallery-columns));
  }

  .gallery-item :global(img) {
    height: auto;
    /* Reserve a square until a lazy image supplies its natural proportions. */
    aspect-ratio: auto 1;
  }

  @media (min-width: 48rem) {
    .masonry-gallery {
      --gallery-columns: 2;
      --gallery-gap: 32px;
    }
  }
</style>

<script>
  import { onEachPage } from '@/lib/pageScript'
  import { initMasonry } from '@/lib/masonry'

  onEachPage(() => {
    const gallery = document.querySelector<HTMLElement>('[data-gallery]')
    if (!gallery) return
    const masonry = gallery.querySelector<HTMLElement>('[data-masonry]')
    if (!masonry) return
    const cleanupMasonry = initMasonry(masonry)

    // Cached so the framework is fetched once per session, not once per click.
    let viewer: Promise<typeof import('./mountLightbox')> | null = null

    // One delegated listener rather than one per image, so a 20-image project
    // costs exactly the same as a single-image one.
    const onClick = async (event: Event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lightbox-open]')
      if (!trigger) return

      const payloadEl = gallery.querySelector<HTMLScriptElement>('[data-gallery-payload]')
      if (!payloadEl?.textContent) return

      const index = Number(trigger.getAttribute('data-lightbox-open'))
      const { images, title } = JSON.parse(payloadEl.textContent)

      // First click pulls in React + the gesture engine; later ones hit the cache.
      viewer ??= import('./mountLightbox')
      const { openLightbox } = await viewer

      openLightbox({ images, title, index: Number.isNaN(index) ? 0 : index })
    }

    gallery.addEventListener('click', onClick)
    return () => {
      cleanupMasonry()
      gallery.removeEventListener('click', onClick)
    }
  })
</script>

---
import type { SeoContent, SiteWithUrl } from '@/content/types'
import { abs } from '@/lib/structuredData'

export interface Props {
  /** Page title (the site name is appended automatically). Overridden by `seo.metaTitle`. */
  title?: string
  /** Overridden by `seo.metaDescription`. */
  description?: string
  /** Absolute-from-root image path, or an absolute URL. Overridden by `seo.ogImage`. */
  image?: string
  /** Route path for canonical + og:url, e.g. "/projects/loss". */
  path?: string
  /** og:type — "website" | "article" | "profile". */
  type?: 'website' | 'article' | 'profile'
  /** Optional JSON-LD structured data object(s). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noIndex?: boolean
  /** Resolved site content, supplied by Base.astro (not part of the page-level Props spread). */
  site: SiteWithUrl
  /**
   * Per-record SEO overrides from the content API (already resolved
   * server-side with that record's own fallbacks — see `SeoContent` in
   * `packages/cms-schema/src/content-contract.ts`). When set, its fields win
   * over `title`/`description`/`image`; when a field is unset, the prop (then
   * the site-level default) is used instead.
   */
  seo?: SeoContent
}

/**
 * Per-page SEO. Astro renders this straight into <head> at build time, so every
 * pre-rendered HTML file ships unique, crawlable metadata — the same job the old
 * <Seo> React component did through react-helmet, with no runtime cost.
 */
const {
  title,
  description,
  image,
  path = '',
  type = 'website',
  jsonLd,
  noIndex,
  site,
  seo,
} = Astro.props

const titleSource = seo?.metaTitle?.trim() || title
const fullTitle = titleSource ? `${titleSource} — ${site.name}` : `${site.name} | ${site.tagline}`

// Fall back through seo.metaDescription -> the page's own description -> the
// site description, so no page ever ships a blank meta description.
const descSource = seo?.metaDescription?.trim() || description?.trim()
const desc = descSource || site.description

const url = `${site.url}${path}`

// Social scrapers (WhatsApp, Facebook, LinkedIn) don't decode AVIF, so the
// shared card should stay a JPEG/PNG/WebP. seo.ogImage (CMS-set) wins, then
// `image` (e.g. a project's hero, passed by the page), then the site
// record's own social image, then the bundled default. `abs()` passes an
// already-absolute URL (e.g. a bucket URL from the API) through unchanged.
const ogImageSource = seo?.ogImage?.trim() || image
const usingDefaultImage = !ogImageSource
const img = abs(site, ogImageSource || site.ogImage || '/og-default.jpg')
const imgAlt = `${site.name} — ${site.tagline}`
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="author" content={site.name} />
{noIndex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={url} />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={url} />
<meta property="og:locale" content="en_GB" />
<meta property="og:image" content={img} />
<meta property="og:image:alt" content={imgAlt} />
{
  usingDefaultImage && (
    <>
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={img} />
<meta name="twitter:image:alt" content={imgAlt} />

{
  blocks.map((block) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
  ))
}

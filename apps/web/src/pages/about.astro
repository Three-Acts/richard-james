---
import Base from '@/layouts/Base.astro'
import Image from '@/components/ui/Image.astro'
import Reveal from '@/components/ui/Reveal.astro'
import { getContentSource } from '@/content'
import { renderMarkdown } from '@/content/markdown'
import { site as staticSite } from '@/data/site'
import { personJsonLd } from '@/lib/structuredData'

const source = await getContentSource()
const [page, siteContent] = await Promise.all([source.getPage('about'), source.getSite()])
if (!page) {
  throw new Error('Content source has no "about" page — run the API seed script or check API_ORIGIN.')
}
const bodyHtml = renderMarkdown(page.body)
const site = { ...siteContent, url: staticSite.url }
---

<Base
  title={page.title}
  path="/about"
  type="profile"
  jsonLd={personJsonLd(site)}
  seo={page.seo}
  image={page.image}
>
  <section class="u-container pb-32 pt-[calc(var(--nav-h)+clamp(4rem,12vw,9rem))]">
    {/* Heading */}
    <Reveal as="header" class="max-w-3xl">
      <p class="u-eyebrow text-gold">About the Artist</p>
      <h1 class="u-display mt-5 text-[clamp(2.5rem,7vw,5rem)] leading-[0.98] text-bone">
        Richard James
      </h1>
      <p class="mt-6 max-w-prose text-[0.98rem] leading-relaxed text-bone-dim">
        South African / UK artist based in Gqeberha (Port Elizabeth), South Africa.
      </p>
    </Reveal>

    {/* Body + accent image */}
    <div
      class="mt-20 grid grid-cols-1 gap-x-16 gap-y-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]"
    >
      {/* Prose column — rendered from the API's markdown body. */}
      <Reveal
        as="div"
        class="prose-body prose-dropcap max-w-[42rem] text-[1.02rem] text-bone-dim"
        set:html={bodyHtml}
      />

      {/* Tall accent artwork — hidden entirely when the page has no portrait set. */}
      {
        page.image && (
          <Reveal delay={0.12} class="lg:sticky lg:top-[calc(var(--nav-h)+2.5rem)] lg:self-start">
            <figure class="overflow-hidden bg-ink-soft">
              <Image
                src={page.image}
                alt="Portrait of Richard James"
                aspectRatio="4/5"
                sizes="(min-width: 1024px) 22rem, 90vw"
                class="h-full w-full"
              />
            </figure>
            <figcaption class="mt-4 flex items-baseline justify-between gap-4">
              <span class="u-display text-[0.8rem] text-bone-dim">Richard James</span>
            </figcaption>
          </Reveal>
        )
      }
    </div>

    {/* Contact CTA */}
    <Reveal class="mt-28 border-t border-line-soft pt-16 text-center">
      <p class="u-eyebrow text-muted">Contact</p>
      <p
        class="mx-auto mt-6 max-w-xl font-display text-[clamp(1.4rem,4vw,2.25rem)] leading-tight text-bone [text-wrap:balance]"
      >
        Get in touch with Richard.
      </p>
      <a href="/contact" class="btn-line mt-10">Get in touch</a>
    </Reveal>
  </section>
</Base>

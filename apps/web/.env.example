# Public site origin — controls canonical URLs, sitemap locations, and social tags.
VITE_SITE_URL=https://example.com

# API bridge origin. In dev the Vite server proxies /api/* here; in Vercel the
# rewrite in vercel.ts performs the same bridge so browser calls stay same-origin.
API_ORIGIN=http://localhost:5175

# Content backend (optional). When both are set, the build/dev content layer
# reads published content from Supabase; otherwise it falls back to mock data.
# Anon key only — read-only. Server-side writes belong in apps/api.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

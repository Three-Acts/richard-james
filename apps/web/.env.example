# Public site origin — controls canonical URLs, sitemap locations, and social tags.
VITE_SITE_URL=https://www.richardjamesart.com

# API bridge origin. Required — the site has no local content and reads
# everything from apps/api at build/dev time. In dev the Vite server also
# proxies /api/* here for the browser; in Vercel the rewrite in vercel.ts
# performs the same bridge so browser calls stay same-origin.
API_ORIGIN=http://localhost:5175

API_ORIGIN=http://localhost:5175

# Which CmsBackend the workspace uses: "mock" (default) is the in-memory
# adapter with generated seed data and no network calls.
# "rest" talks to the real API's /api/cms/* routes (see @three-acts/cms-schema).
VITE_CMS_BACKEND=mock

# Only used when VITE_CMS_BACKEND=rest: where the API lives. Point this at the
# API dev server directly, or leave it unset to go through the dev proxy.
VITE_API_URL=

# Bearer token the CMS attaches to API requests (Authorization: Bearer <token>).
# Must exactly match the API server's own PUBLISH_TOKEN env var. Required for
# VITE_CMS_BACKEND=rest (and for the existing /deploy publish flow either way).
# This is a stopgap until a real auth provider issues session tokens — remove
# once that lands.
VITE_PUBLISH_TOKEN=
